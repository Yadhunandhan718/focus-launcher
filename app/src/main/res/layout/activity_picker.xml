<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pickerRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/pickerTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="12dp" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/pickerDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="12dp" android:textColor="@color/text_dim" android:textSize="14sp" />
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/search_bg" android:hint="Search apps" android:imeOptions="actionGo"
        android:importantForAutofill="no" android:inputType="textNoSuggestions" android:maxLines="1"
        android:padding="16dp" android:textColor="@color/text" android:textColorHint="@color/text_dim" android:textSize="20sp" />
    <ListView android:id="@+id/appList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="8dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" />
    <Button android:id="@+id/pickerDone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Continue" android:visibility="gone" />
</LinearLayout>
